  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/retvest/RIL.git",
    "directory": "sdks/ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
