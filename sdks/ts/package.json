{
  "name": "@retvest/ril",
  "version": "0.3.0",
  "description": "Zero-dependency Node SDK for the RIL (Retvest Intent Language) verifier CLI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
