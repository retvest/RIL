{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RIL Laws",
  "scopeName": "source.ril",
  "fileTypes": ["ril"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#header" },
    { "include": "#law-declaration" },
    { "include": "#decision-verbs" },
    { "include": "#evidence" },
    { "include": "#keywords" },
    { "include": "#entity-refs" },
    { "include": "#booleans" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ril",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ril",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ril",
              "match": "\\\\([\"\\\\nt])"
            }
          ]
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "match": "^\\s*(laws)\\s+(\"[^\"]*\")\\s+(version)\\s+([0-9]+)",
          "captures": {
            "1": { "name": "keyword.declaration.laws.ril" },
            "2": { "name": "string.quoted.double.ril" },
            "3": { "name": "keyword.other.version.ril" },
            "4": { "name": "constant.numeric.integer.ril" }
          }
        }
      ]
    },
    "law-declaration": {
      "patterns": [
        {
          "match": "^\\s*(law)\\s+([a-z][a-z0-9-]{0,63})\\b",
          "captures": {
            "1": { "name": "keyword.declaration.law.ril" },
            "2": { "name": "entity.name.function.law.ril" }
          }
        }
      ]
    },
    "decision-verbs": {
      "patterns": [
        {
          "name": "keyword.control.permit.ril",
          "match": "\\bpermit\\b"
        },
        {
          "name": "keyword.control.ask.ril",
          "match": "\\bask\\b"
        },
        {
          "name": "keyword.control.forbid.ril",
          "match": "\\bforbid\\b"
        }
      ]
    },
    "evidence": {
      "patterns": [
        {
          "name": "storage.modifier.evidence.proved.ril",
          "match": "\\b(proved|tested|watched)\\b"
        },
        {
          "name": "support.function.tool.ril",
          "match": "\\b(kani|verus|lean|cedar-analysis|quint|bend)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.structure.ril",
          "match": "\\b(laws|version|law|says|why|on|action|of|code|evidence|by|command|in)\\b"
        },
        {
          "name": "keyword.control.condition.ril",
          "match": "\\b(when|has|like|if|then|else)\\b"
        },
        {
          "name": "variable.language.ril",
          "match": "\\b(principal|resource|context)\\b"
        }
      ]
    },
    "entity-refs": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(::)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.name.type.ril" },
            "2": { "name": "punctuation.separator.namespace.ril" },
            "3": { "name": "string.quoted.double.ril" }
          }
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.ril",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.ril",
          "match": "(?<![A-Za-z0-9_])-?[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.ril",
          "match": "&&|\\|\\||!|==|!=|<=|>=|<|>"
        },
        {
          "name": "support.function.method.ril",
          "match": "\\.(containsAll|containsAny|contains)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.ril",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
